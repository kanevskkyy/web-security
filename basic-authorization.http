### 1. [USER] GET /api/categories - @PreAuthorize("hasAnyRole('USER', 'MANAGER', 'ADMIN')") -> Allowed (200 OK)
GET http://localhost:8080/api/categories
Authorization: Basic user user123
Accept: application/json

> {%
    client.test("USER: Read categories allowed via @PreAuthorize", function() {
        client.assert(response.status === 200, "Expected status code 200");
    });
%}

### 2. [USER] GET /api/products - @PreAuthorize("hasAnyRole('USER', 'MANAGER', 'ADMIN')") -> Allowed (200 OK)
GET http://localhost:8080/api/products
Authorization: Basic user user123
Accept: application/json

> {%
    client.test("USER: Read products allowed via @PreAuthorize", function() {
        client.assert(response.status === 200, "Expected status code 200");
    });
%}

### 3. [USER] POST /api/categories - @PreAuthorize("hasAnyRole('MANAGER', 'ADMIN')") -> Forbidden (403 Forbidden)
POST http://localhost:8080/api/categories
Authorization: Basic user user123
Content-Type: application/json

{
  "name": "Electronics",
  "description": "Electronic gadgets and devices"
}

> {%
    client.test("USER: Create category forbidden via @PreAuthorize", function() {
        client.assert(response.status === 403, "Expected status code 403");
    });
%}

### 4. [USER] DELETE /api/products/1 - @PreAuthorize("hasRole('ADMIN')") -> Forbidden (403 Forbidden)
DELETE http://localhost:8080/api/products/1
Authorization: Basic user user123

> {%
    client.test("USER: Delete product forbidden via @PreAuthorize", function() {
        client.assert(response.status === 403, "Expected status code 403");
    });
%}

### 5. [MANAGER] POST /api/categories - @PreAuthorize("hasAnyRole('MANAGER', 'ADMIN')") -> Allowed (201 Created)
POST http://localhost:8080/api/categories
Authorization: Basic manager manager123
Content-Type: application/json

{
  "name": "Smartphones",
  "description": "Mobile phones and accessories"
}

> {%
    client.test("MANAGER: Create category allowed via @PreAuthorize", function() {
        client.assert(response.status === 201, "Expected status code 201");
    });
%}

